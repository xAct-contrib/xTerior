              RowBox[{"expr1", "\[Wedge]", RowBox[{"expr2", "[", 
                  RowBox[{RowBox[{"-", RowBox[{"First", "@", RowBox[
                         {"Select", "[", RowBox[{RowBox[{RowBox[{"IndicesOf", 
                          "[", "Free", "]"}], "[", "expr1", "]"}], ",", 
