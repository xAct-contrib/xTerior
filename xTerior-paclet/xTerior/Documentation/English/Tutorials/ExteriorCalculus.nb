         {RowBox[{RowBox[{RowBox[{"Grade", "[", RowBox[{RowBox[{"TR", "[", 
                    "expr_", "]"}], ",", "Wedge"}], "]"}], "^:=", 
              RowBox[{"Grade", "[", RowBox[{"expr", ",", "Wedge"}], "]"}]}], 
            ";"}], "\n"}], "\[IndentingNewLine]", 
        RowBox[{RowBox[{RowBox[{RowBox[{"addfactor", "[", RowBox[{"expr1_", 
