        Cell[BoxData[RowBox[{"CodiffToDiff", "[", StyleBox["expr", "TI"], 
            "]"}]], "InlineFormula"], " \[LineSeparator]expands \
codifferentials in expr into Hodge duals and exterior derivatives."}], 
      "Usage", CellID -> 112005], Cell["For a p-form in dimension n, the \
implemented sign is (-1)^(n p + n + q), where q is the number of negative \
metric directions from SignatureOfMetric.", "Notes", CellID -> 112006], 
     Cell["The resulting expression has the form (-1)^(n p + n + q) \
Hodge[metric][Diff[Hodge[metric][form], covd]]. The covariant derivative is \
preserved.", "Notes", CellID -> 112007], 
     Cell["Replacement is repeated, so nested codifferentials are expanded as \
well.", "Notes", CellID -> 112008]}, Open]], 
