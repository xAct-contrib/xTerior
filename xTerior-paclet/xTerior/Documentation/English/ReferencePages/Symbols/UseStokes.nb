        Cell[BoxData[RowBox[{"UseStokes", "[", StyleBox["expr", "TI"], 
            "]"}]], "InlineFormula"], " \[LineSeparator]replaces integrals of \
ordinary exterior derivatives by boundary integrals.", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{"UseStokes", "[", 
            RowBox[{StyleBox["expr", "TI"], ",", StyleBox["mani", "TI"]}], 
            "]"}]], "InlineFormula"], " \[LineSeparator]restricts the forward \
transformation to integrals over mani.", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{"UseStokes", "[", RowBox[
             {StyleBox["expr", "TI"], ",", StyleBox["form", "TI"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]turns boundary integrals of the \
specified form into integrals of its exterior derivative."}], "Usage", 
      CellID -> 139008], Cell["The forward rule replaces \
FormIntegrate[Diff[form, PD], mani] with FormIntegrate[form, \
ManifoldBoundary[mani]].", "Notes", CellID -> 139009], 
     Cell["The second argument is interpreted as a manifold when ManifoldQ \
returns True; otherwise it selects the form for the reverse transformation.", 
      "Notes", CellID -> 139010], Cell["Use xTensor's ManifoldBoundary \
notation for the boundary. The transformation is symbolic and does not check \
analytic hypotheses of Stokes' theorem.", "Notes", CellID -> 139011]}, 
