Notebook[{Cell[CellGroupData[{Cell["TorsionForm", "ObjectName", 
      CellID -> 134007], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{"TorsionForm", "[", StyleBox["covd", 
               "TI"], "]"}], "[", StyleBox["a", "TI"], "]"}]], 
         "InlineFormula"], " \[LineSeparator]represents the \
tangent-bundle-valued torsion two-form of covd."}], "Usage", 
      CellID -> 134008], Cell["covd must be a covariant derivative on a \
tangent bundle. The form has one contravariant tangent-bundle slot and \
exterior degree two.", "Notes", CellID -> 134009], Cell["Use DefCovD with \
Torsion -> True when working with a connection with torsion. UseCartan \
includes torsion in the first structure equation when TorsionQ[covd] is \
True.", "Notes", CellID -> 134010], Cell["The supplied abstract TorsionForm \
head does not automatically reduce to zero for torsion-free derivatives; use \
the connection's torsion information explicitly.", "Notes", 
      CellID -> 134011]}, Open]], 
