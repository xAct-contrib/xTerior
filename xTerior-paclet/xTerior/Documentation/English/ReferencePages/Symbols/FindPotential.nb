Notebook[{Cell[CellGroupData[{Cell["FindPotential", "ObjectName", 
      CellID -> 107007], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{"FindPotential", "[", 
            RowBox[{StyleBox["form", "TI"], ",", StyleBox["point", "TI"], 
              ",", StyleBox["chart", "TI"]}], "]"}]], "InlineFormula"], " \
\[LineSeparator]constructs a local potential for a closed coordinate form on \
a region star-shaped about point."}], "Usage", CellID -> 107008], 
     Cell["Write form using the coordinate scalars of an xCoba chart and \
their differentials, combined with Wedge. point is a list in the order \
returned by ScalarsOfChart[chart].", "Notes", CellID -> 107009], 
     Cell["The function uses the Poincare homotopy construction and assumes \
that form is closed. It does not check closedness or global exactness.", 
      "Notes", CellID -> 107010], Cell["Changing point can change the chosen \
potential. Integration options are passed to Integrate in the branches that \
carry out integration.", "Notes", CellID -> 107011], 
     Cell["Verify a proposed potential by differentiating it.", "Notes", 
      CellID -> 107012]}, Open]], 
