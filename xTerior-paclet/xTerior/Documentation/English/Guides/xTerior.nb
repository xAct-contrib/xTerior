Notebook[{

Cell[CellGroupData[{
Cell["xTerior: Exterior Calculus", "GuideTitle",
 CellID->900047, ExpressionUUID->"c3524304-f19d-4a36-bccf-f83e87e92d3e"],

Cell["\<\
xTerior extends xAct with differential forms, exterior covariant \
differentiation, Hodge duality, frame calculus, and symbolic integration. \
Install xAct (including xTensor and xCoba), then load the package with Needs[\
\"xAct`xTerior`\"].\
\>", "GuideAbstract",
 CellID->900048, ExpressionUUID->"a18c9a32-a211-4fd8-a903-3c0046977ba9"],

Cell["\<\
The reference pages cover all 39 symbols with usage messages in the supplied \
version 0.9.1. Pages for declared but unimplemented symbols describe their \
current limitations. Run each page's setup once in a fresh kernel.\
\>", "GuideAbstract",
 CellChangeTimes->{{4.002381727394517*^9, 4.00238173637894*^9}},
 CellID->900049, ExpressionUUID->"fc59cedb-5a78-40d3-b37e-d92e5f93acf7"]
}, Open  ]],

